generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MENTOR
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewDecision {
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions ProjectSubmission[] @relation("SubmittedBy")
  reviews     ProjectReview[]     @relation("ReviewedBy")

  @@index([role])
}

model ProjectSubmission {
  id          String           @id @default(cuid())
  title       String
  description String
  repoUrl     String
  liveUrl     String?
  status      SubmissionStatus @default(PENDING)

  studentId String
  student   User   @relation("SubmittedBy", fields: [studentId], references: [id], onDelete: Cascade)

  // The current workflow state; matches the decision of `review` once reviewed.
  review ProjectReview?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One student cannot submit the same repository twice.
  @@unique([studentId, repoUrl])
  @@index([studentId, createdAt])
  @@index([status, createdAt])
}

model ProjectReview {
  id String @id @default(cuid())

  submissionId String            @unique
  submission   ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  reviewerId String
  reviewer   User   @relation("ReviewedBy", fields: [reviewerId], references: [id], onDelete: Restrict)

  // Why the submission was approved or rejected.
  decision ReviewDecision
  note     String?

  // When the review was completed.
  reviewedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewerId, reviewedAt])
  @@index([decision, reviewedAt])
}
