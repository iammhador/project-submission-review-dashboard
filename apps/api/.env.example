NODE_ENV=development
PORT=4000

# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://awi:awi@localhost:5432/awi?schema=public"

# Generate a strong secret, e.g. `openssl rand -base64 48`
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_EXPIRES_IN=7d

# URL of the Next.js app, used for CORS
CORS_ORIGIN=http://localhost:3000

# Mentor account created by `pnpm db:seed`
SEED_MENTOR_NAME="AWI Mentor"
SEED_MENTOR_EMAIL=mentor@awi.dev
SEED_MENTOR_PASSWORD=mentor-password-123
