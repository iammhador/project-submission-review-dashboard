{
  "name": "associate-web-instructor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @awi/shared build && pnpm --parallel -r --filter @awi/api --filter @awi/web dev",
    "dev:web": "pnpm --filter @awi/web dev",
    "dev:api": "pnpm --filter @awi/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @awi/shared build && pnpm -r --if-present test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @awi/api prisma:generate",
    "db:migrate": "pnpm --filter @awi/api prisma:migrate",
    "db:seed": "pnpm --filter @awi/api prisma:seed",
    "db:studio": "pnpm --filter @awi/api prisma:studio"
  }
}
